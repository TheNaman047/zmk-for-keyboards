#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

&mt { quick-tap-ms = <150>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0 {
            bindings = <
&none  &kp Q  &kp W  &kp E           &kp R           &kp T           &kp Y      &kp U            &kp I            &kp O    &kp P     &none
&none  &kp A  &kp S  &hm LEFT_ALT D  &hm LEFT_GUI F  &kp G           &kp H      &hm RIGHT_GUI J  &hm RIGHT_ALT K  &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C           &kp V           &kp B           &kp N      &kp M            &kp COMMA        &kp DOT  &kp FSLH  &none
                     &none           &kp SPACE       &kp LEFT_SHIFT  &kp RCTRL  &to 1            &to 4
            >;

            label = "0";
        };

        L1 {
            bindings = <
&none  &kp ESC  &kp EXCLAMATION  &mt LG(LS(X)) AT_SIGN      &kp HASH                 &kp DOLLAR      &kp PERCENT        &kp CARET                  &kp AMPERSAND                &kp ASTERISK  &kp BACKSPACE  &none
&none  &kp TAB  &kp EQUAL        &hm LEFT_ALT LEFT_BRACKET  &hm LEFT_WIN LEFT_BRACE  &kp SQT         &kp DOUBLE_QUOTES  &hm RIGHT_WIN RIGHT_BRACE  &hm RIGHT_ALT RIGHT_BRACKET  &kp MINUS     &kp ENTER      &none
&none  &to 3    &kp GRAVE        &kp BACKSLASH              &kp LEFT_PARENTHESIS     &kp LESS_THAN   &kp GREATER_THAN   &kp RIGHT_PARENTHESIS      &kp SLASH                    &kp PIPE      &none          &none
                                 &none                      &to 0                    &kp LEFT_SHIFT  &kp LEFT_CONTROL   &to 2                      &to 4
            >;

            label = "1";
        };

        L2 {
            bindings = <
&none  &kp ESC  &kp LG(LEFT_BRACKET)  &kp LC(LS(TAB))       &kp LC(TAB)         &kp LG(RIGHT_BRACKET)  &kp NUMBER_7  &kp NUMBER_8            &kp NUMBER_9            &kp MINUS     &kp BACKSPACE  &none
&none  &kp TAB  &none                 &hm LEFT_ALT PERCENT  &hm LEFT_GUI MINUS  &kp KP_PLUS            &kp NUMBER_4  &hm RIGHT_GUI NUMBER_5  &hm RIGHT_ALT NUMBER_6  &kp EQUAL     &kp ENTER      &none
&none  &none    &none                 &none                 &kp KP_MULTIPLY     &kp SLASH              &kp NUMBER_1  &kp NUMBER_2            &kp NUMBER_3            &kp NUMBER_0  &none          &none
                                      &to 3                 &to 0               &kp LEFT_SHIFT         &kp RCTRL     &to 1                   &to 4
            >;

            label = "2";
        };

        L3 {
            bindings = <
&none  &kp ESC  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp Q         &kp C_VOLUME_DOWN           &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp BACKSPACE  &none
&none  &kp TAB  &none       &none             &none       &kp DEL       &kp LEFT                    &kp DOWN         &kp UP                &kp RIGHT             &kp ENTER      &none
&none  &none    &none       &none             &none       &none         &none                       &none            &none                 &none                 &none          &none
                            &none             &to 0       &kp LEFT_WIN  &hm RIGHT_ALT LC(LEFT_ALT)  &to 1            &to 4
            >;

            label = "3";
        };

        L4 {
            bindings = <
&trans  &trans      &trans      &trans      &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans      &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &ext_power EP_TOG  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans      &to 0              &trans  &trans  &to 1   &trans
            >;
        };
    };
};
