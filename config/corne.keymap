#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0 {
            bindings = <
&none  &kp Q  &kp W  &kp E           &kp R                        &kp T           &kp Y      &kp U            &kp I            &kp O    &kp P     &none
&none  &kp A  &kp S  &hm LEFT_ALT D  &hm LEFT_GUI F               &kp G           &kp H      &hm RIGHT_GUI J  &hm RIGHT_ALT K  &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C           &kp V                        &kp B           &kp N      &kp M            &kp COMMA        &kp DOT  &kp FSLH  &none
                     &to 3           &mt LC(LA(LS(SPACE))) SPACE  &kp LEFT_SHIFT  &kp RCTRL  &to 1            &to 4
            >;

            label = "0";
        };

        L1 {
            bindings = <
&none  &kp ESC  &kp EXCLAMATION  &mt LG(LS(X)) AT_SIGN      &kp HASH                 &kp DOLLAR      &kp PERCENT        &kp CARET                  &kp AMPERSAND                &kp ASTERISK  &kp BACKSPACE  &none
&none  &kp TAB  &kp EQUAL        &hm LEFT_ALT LEFT_BRACKET  &hm LEFT_WIN LEFT_BRACE  &kp SQT         &kp DOUBLE_QUOTES  &hm RIGHT_WIN RIGHT_BRACE  &hm RIGHT_ALT RIGHT_BRACKET  &kp MINUS     &kp ENTER      &none
&none  &none    &none            &kp SLASH                  &kp LEFT_PARENTHESIS     &kp LESS_THAN   &kp GREATER_THAN   &kp RIGHT_PARENTHESIS      &kp PIPE                     &none         &none          &none
                                 &to 3                      &to 0                    &kp LEFT_SHIFT  &kp LEFT_CONTROL   &to 2                      &to 4
            >;

            label = "1";
        };

        L2 {
            bindings = <
&none  &kp ESC  &kp LG(LEFT_BRACKET)  &kp LC(LS(TAB))  &kp LC(TAB)   &kp LG(RIGHT_BRACKET)  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS     &kp BACKSPACE  &none
&none  &kp TAB  &none                 &kp PERCENT      &kp MINUS     &kp LS(EQUAL)          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &kp ENTER      &none
&none  &none    &none                 &none            &kp ASTERISK  &kp SLASH              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &none          &none
                                      &to 3            &to 0         &kp LEFT_GUI           &kp LEFT_ALT  &to 1         &to 4
            >;

            label = "2";
        };

        L3 {
            bindings = <
&none  &kp ESC  &none           &none           &none            &kp Q         &kp LG(LBKT)   &kp LS(LC(TAB))  &kp LC(TAB)  &kp LG(RBKT)  &kp BACKSPACE  &none
&none  &kp TAB  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_DOWN   &kp DEL       &kp LEFT       &kp DOWN         &kp UP       &kp RIGHT     &kp ENTER      &none
&none  &to 4    &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &none         &none          &none            &none        &none         &none          &none
                                &none           &to 0            &kp LEFT_WIN  &kp RIGHT_ALT  &to 1            &none
            >;

            label = "3";
        };

        L4 {
            bindings = <
&trans  &trans      &trans      &trans      &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans      &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &ext_power EP_TOG  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans      &to 0              &trans  &trans  &to 1   &trans
            >;
        };
    };
};
