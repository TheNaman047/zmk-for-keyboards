#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0 {
            bindings = <
&none  &kp Q  &kp W  &kp E           &kp R                        &kp T           &kp Y      &kp U            &kp I            &kp O    &kp P     &none
&none  &kp A  &kp S  &hm LEFT_ALT D  &hm LEFT_GUI F               &kp G           &kp H      &hm RIGHT_GUI J  &hm RIGHT_ALT K  &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C           &kp V                        &kp B           &kp N      &kp M            &kp COMMA        &kp DOT  &kp FSLH  &none
                     &none           &mt LC(LA(LS(SPACE))) SPACE  &kp LEFT_SHIFT  &kp RCTRL  &to 1            &none
            >;

            label = "0";
        };

        L1 {
            bindings = <
&none  &kp ESC    &kp AT      &mt LG(LS(X)) HASH    &kp DLLR              &kp PERCENT     &kp CARET         &kp AMPS               &kp ASTRK              &kp EXCLAMATION  &kp BACKSPACE  &none
&none  &kp TAB    &kp EQUAL   &kp LEFT_BRACKET      &kp LEFT_BRACE        &kp SQT         &kp BSLH          &kp RIGHT_BRACE        &kp RIGHT_BRACKET      &kp MINUS        &kp ENTER      &none
&none  &kp GRAVE  &kp LA(N3)  &kp LG(LEFT_BRACKET)  &kp LEFT_PARENTHESIS  &kp LESS_THAN   &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp LG(RIGHT_BRACKET)  &kp PIPE         &to 3          &none
                              &none                 &to 0                 &kp LEFT_SHIFT  &kp LEFT_ALT      &to 2                  &none
            >;

            label = "1";
        };

        L2 {
            bindings = <
&none  &kp ESC  &kp C_PREV            &kp C_PP   &kp C_NEXT            &kp LS(MINUS)  &kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE  &none
&none  &kp TAB  &kp C_VOL_DN          &kp SLASH  &kp C_VOL_UP          &kp LS(EQUAL)  &kp EQUAL     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER      &none
&none  &to 4    &kp C_BRIGHTNESS_DEC  &kp ASTRK  &kp C_BRIGHTNESS_INC  &kp BSLH       &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &to 3          &none
                                      &none      &to 0                 &kp LEFT_GUI   &kp LEFT_ALT  &to 1         &none
            >;

            label = "2";
        };

        L3 {
            bindings = <
&none  &kp ESC  &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &kp Q         &kp LG(LBKT)   &kp LS(LC(TAB))  &kp LC(TAB)  &kp LG(RBKT)  &kp BACKSPACE  &none
&none  &kp TAB  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_DOWN   &kp DEL       &kp LEFT       &kp DOWN         &kp UP       &kp RIGHT     &kp ENTER      &none
&none  &to 4    &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &none         &none          &none            &none        &none         &none          &none
                                &none           &to 0            &kp LEFT_WIN  &kp RIGHT_ALT  &to 1            &none
            >;

            label = "3";
        };

        bt {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
